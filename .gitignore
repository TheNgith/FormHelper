# Dependencies
node_modules

# Build output
dist
dist-ssr
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment — per-deployment values, never committed
.env
.env.*
!.env.example

# Firebase — bộ nhớ đệm của CLI và dữ liệu emulator xuất ra
.firebase/
.emulator-data/

# Khóa service account cho scripts/export-csv.ts. Bí mật thật sự duy nhất của
# dự án, và nó chỉ được sống trên máy người phụ trách.
*service-account*.json
serviceAccountKey.json

# Bản xuất CSV — chứa dữ liệu cá nhân của sinh viên
*.csv

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ghi chú và bản ghi của công cụ chạy tại máy, không thuộc dự án
*.jsonl
scratch/

# Bản PDF dựng thử
preview/

# Tài liệu
docs/
