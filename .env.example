# Copy to .env and fill in before building.
#
# Both values end up in the JavaScript bundle and are readable by anyone who
# opens DevTools. That is unavoidable for a static site writing to a Sheet —
# see the "Bảo mật" section of README.md.

# The /exec URL of the Apps Script web app (Deploy -> New deployment -> Web app).
VITE_SHEETS_ENDPOINT=https://script.google.com/macros/s/XXXXXXXXXXXX/exec

# Shared string; must match the TOKEN constant in apps-script/Code.gs.
VITE_SHEETS_TOKEN=change-me
