{
  "name": "don-xin-su-dung-thiet-bi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run test:rules",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-don-thiet-bi \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-don-thiet-bi",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "export:csv": "tsx scripts/export-csv.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "lint": "oxlint"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "pdfmake": "^0.3.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^24.13.3",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.26.0",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
